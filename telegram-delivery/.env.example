# --- Serveur
PORT=3000
PUBLIC_URL=https://ton-service.exemple.com

# --- Shopify
SHOPIFY_SHOP_DOMAIN=ma-boutique.myshopify.com
SHOPIFY_API_VERSION=2025-10
# Option A : jeton Admin API d'une app personnalisée (shpat_...)
SHOPIFY_ADMIN_TOKEN=
# Option B : app créée dans le Dev Dashboard (client credentials)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Secret de signature des webhooks (Paramètres > Notifications > Webhooks, ou secret client de l'app)
SHOPIFY_WEBHOOK_SECRET=
# ID numérique du/des produit(s) « Accès au groupe » (séparés par des virgules)
ACCESS_PRODUCT_IDS=

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ID du groupe privé (supergroupe), ex : -1001234567890
TELEGRAM_CHAT_ID=
# Chaîne aléatoire longue (ex : openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
INVITE_TTL_HOURS=72
# remove = retirer le membre (peut revenir avec un nouvel achat) | ban = bannir définitivement
REVOKE_MODE=remove

# --- E-mail (optionnel, sinon délivrance via le bot uniquement)
RESEND_API_KEY=
EMAIL_FROM=Mafia Running <acces@ton-domaine.fr>
EMAIL_REPLY_TO=
BRAND_NAME=Mafia Running

CLAIM_MAX_ATTEMPTS_PER_HOUR=5
