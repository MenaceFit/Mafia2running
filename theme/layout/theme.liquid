<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js{% unless settings.animations %} no-anim{% endunless %}{% if request.design_mode %} shopify-design-mode{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- liquid
      assign brand = settings.brand_name | default: shop.name
      if page_title == blank
        assign title_text = brand
      else
        assign title_text = page_title
      endif
    -%}
    <title>
      {{ title_text }}
      {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
      {%- unless title_text contains brand %} – {{ brand }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- render 'css-variables' -%}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.themeConfig = {
        tracking: {{ settings.tracking_enabled | json }},
        directCheckout: {{ settings.direct_checkout | json }},
        routes: {
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartClear: {{ routes.cart_clear_url | append: '.js' | json }},
          cart: {{ routes.cart_url | json }}
        },
        strings: {
          error: "Une erreur est survenue. Réessaie ou contacte-nous.",
          waiver: "Coche la case pour confirmer l'accès immédiat au contenu numérique.",
          unavailable: "Ce produit n'est pas disponible pour le moment."
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {% render 'structured-data' %}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#MainContent">Aller au contenu</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.sticky_cta -%}
      {% render 'sticky-cta' %}
    {%- endif -%}

    <div class="toast" role="status" aria-live="polite" hidden></div>
  </body>
</html>
