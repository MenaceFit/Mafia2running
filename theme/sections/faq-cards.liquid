<section class="section section--tight fq" id="{{ section.settings.anchor | handle }}" aria-labelledby="FqTitle-{{ section.id }}">
  <div class="container container--narrow">
    <h2 id="FqTitle-{{ section.id }}" class="fq__title">{{ section.settings.title }}</h2>
    <div class="fq__list">
      {%- for block in section.blocks -%}
        <details class="fq__item" data-accordion {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="fq__plus" aria-hidden="true"></span>
          </summary>
          <div class="accordion__content">
            <div class="fq__answer rte">{{ block.settings.answer }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <p class="fq__more">
        <span>{{ section.settings.more_text }}</span>
        <a href="{{ section.settings.button_link }}" class="btn btn--gold">{{ section.settings.button_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% stylesheet %}
  .fq__title { font-family: var(--font-heading); font-weight: 800; text-align: center; font-size: clamp(1.9rem, 5vw, 2.6rem); letter-spacing: -.03em; color: var(--c-primary); margin-bottom: 28px; }
  .fq__title::after { content: ""; display: block; width: 64px; height: 3px; margin: 12px auto 0; border-radius: 3px; background: linear-gradient(90deg, transparent, var(--c-gold, #d4af37), transparent); box-shadow: 0 0 14px var(--c-gold, #d4af37); }
  .fq__list { display: grid; gap: 12px; }
  .fq__item { border-radius: 22px; border: 1px solid rgba(212,175,55,.28); background: linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.015)); transition: border-color .25s, box-shadow .25s; }
  .fq__item[open], .fq__item:hover { border-color: rgba(212,175,55,.7); box-shadow: 0 0 26px rgba(212,175,55,.18); }
  .fq__item summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 18px 18px; cursor: pointer; font-family: var(--font-heading); font-weight: 700; font-size: 1.05rem; color: var(--c-primary); -webkit-tap-highlight-color: transparent; }
  .fq__item summary::-webkit-details-marker { display: none; }
  .fq__plus { position: relative; flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid var(--c-gold, #d4af37); transition: transform .3s, background-color .3s; }
  .fq__plus::before, .fq__plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; border-radius: 2px; background: var(--c-gold, #d4af37); transition: transform .3s, background-color .3s; }
  .fq__plus::after { transform: rotate(90deg); }
  .fq__item[open] .fq__plus { background: var(--c-gold, #d4af37); transform: rotate(180deg); box-shadow: 0 0 14px rgba(212,175,55,.6); }
  .fq__item[open] .fq__plus::before, .fq__item[open] .fq__plus::after { background: #111; }
  .fq__item[open] .fq__plus::after { transform: rotate(0deg); }
  .fq__item .accordion__content { overflow: hidden; }
  .fq__answer { padding: 0 18px 18px; color: var(--c-muted); line-height: 1.6; }
  .fq__answer > * + * { margin-top: .7em; }
  .fq__more { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 16px; color: var(--c-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ cartes",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (ID)", "default": "faq" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Tes questions" },
    { "type": "text", "id": "more_text", "label": "Texte avant le bouton", "default": "Une autre question ? 💬" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Nous contacter →" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "✅ Les produits sont-ils authentiques ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Réponse à rédiger.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "FAQ cartes" } ]
}
{% endschema %}
