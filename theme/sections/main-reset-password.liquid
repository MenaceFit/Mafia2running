<section class="section section--tight">
  <div class="container container--narrow" style="max-width:560px;display:grid;gap:24px">
    <h1 class="h1">Nouveau mot de passe</h1>
    {%- form 'reset_customer_password', class: 'form-grid' -%}
      {%- if form.errors -%}<div class="notice notice--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">Mot de passe</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPassword2">Confirmation</label><input id="ResetPassword2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn btn--lg" type="submit">Enregistrer</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Réinitialisation", "settings": [] }
{% endschema %}
