<section class="section section--tight">
  <div class="container">
    <header class="page-head" style="padding-top:0">
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte lead">{{ collection.description }}</div>{%- endif -%}
    </header>
    {%- paginate collection.products by 24 -%}
      <div class="grid-products">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="muted">Aucun produit pour le moment.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
