<section class="section section--tight">
  <div class="container">
    <header class="page-head" style="padding-top:0"><h1 class="h1">{{ blog.title }}</h1></header>
    {%- paginate blog.articles by 12 -%}
      <div class="grid-products">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="product-card">
            <div class="product-card__media">{% render 'media', image: article.image, label: article.title, art: 'lines', sizes: '(min-width: 750px) 33vw, 100vw' %}</div>
            <p class="small muted">{{ article.published_at | date: '%d/%m/%Y' }}</p>
            <p class="h4">{{ article.title }}</p>
          </a>
        {%- else -%}
          <p class="muted">Aucun article pour le moment.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
