<section class="section{% if section.settings.surface %} section--surface{% endif %}" id="{{ section.settings.anchor | handle }}" aria-labelledby="Title-{{ section.id }}">
  <div class="container">
    <div class="split{% if section.settings.media_left %} split--reverse{% endif %}">
      <div>
        <div class="section-head" style="margin-bottom: 0">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 id="Title-{{ section.id }}" class="h2" data-reveal style="--reveal-i: 1">{% render 'highlight', text: section.settings.title %}</h2>
          {%- if section.settings.subtitle != blank -%}<p class="lead" data-reveal style="--reveal-i: 2">{{ section.settings.subtitle }}</p>{%- endif -%}
        </div>

        <ul class="running__cards" role="list">
          {%- for block in section.blocks -%}
            <li class="card" data-reveal style="--reveal-i: {{ forloop.index0 | modulo: 2 }}" {{ block.shopify_attributes }}>
              <span class="card__icon">{% render 'icon', name: block.settings.icon %}</span>
              <h3 class="h4">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p class="card__text">{{ block.settings.text }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="running__media" data-reveal="scale">
        <figure class="media-frame">
          {% render 'media', image: section.settings.image_1, sizes: '(min-width: 990px) 340px, 55vw', label: 'Running', sublabel: 'Image 1', art: 'lines' %}
          {%- if section.settings.tag_1 != blank -%}<figcaption class="media-frame__tag">{{ section.settings.tag_1 }}</figcaption>{%- endif -%}
        </figure>
        <figure class="media-frame">
          {% render 'media', image: section.settings.image_2, sizes: '(min-width: 990px) 270px, 45vw', label: 'Sportswear', sublabel: 'Image 2', art: 'rings' %}
          {%- if section.settings.tag_2 != blank -%}<figcaption class="media-frame__tag">{{ section.settings.tag_2 }}</figcaption>{%- endif -%}
        </figure>
        <figure class="media-frame">
          {% render 'media', image: section.settings.image_3, sizes: '(min-width: 990px) 270px, 45vw', label: 'Équipement', sublabel: 'Image 3', dark: true, art: 'lines' %}
          {%- if section.settings.tag_3 != blank -%}<figcaption class="media-frame__tag">{{ section.settings.tag_3 }}</figcaption>{%- endif -%}
        </figure>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Univers Running",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancre (ID)", "default": "running" },
    { "type": "checkbox", "id": "surface", "label": "Fond gris clair", "default": false },
    { "type": "checkbox", "id": "media_left", "label": "Images à gauche", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Univers 01" },
    { "type": "text", "id": "title", "label": "Titre", "default": "L'univers *RUNNING*" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Des ressources spécialisées pour trouver des articles sportswear et running authentiques." },
    { "type": "header", "content": "Images", "info": "Utilise des photos dont tu détiens les droits (photos personnelles, banques d'images sous licence). Format portrait conseillé, 1200 px minimum." },
    { "type": "image_picker", "id": "image_1", "label": "Image principale" },
    { "type": "text", "id": "tag_1", "label": "Étiquette image principale", "default": "Nike Running" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "tag_2", "label": "Étiquette image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "text", "id": "tag_3", "label": "Étiquette image 3" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Avantage",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "contact", "options": [{"value": "running", "label": "Running"}, {"value": "diamond", "label": "Diamant"}, {"value": "bot", "label": "Bot"}, {"value": "package", "label": "Colis"}, {"value": "tag", "label": "Étiquette"}, {"value": "recycle", "label": "Seconde main"}, {"value": "truck", "label": "Livraison"}, {"value": "contact", "label": "Contact"}, {"value": "users", "label": "Communauté"}, {"value": "bell", "label": "Alerte"}, {"value": "search", "label": "Recherche"}, {"value": "zap", "label": "Éclair"}, {"value": "clock", "label": "Horloge"}, {"value": "shield", "label": "Bouclier"}, {"value": "lock", "label": "Cadenas"}, {"value": "target", "label": "Cible"}, {"value": "compass", "label": "Boussole"}, {"value": "camera", "label": "Photo"}, {"value": "chart", "label": "Graphique"}, {"value": "message", "label": "Message"}, {"value": "handshake", "label": "Accompagnement"}, {"value": "cap", "label": "Formation"}, {"value": "spark", "label": "Étoile"}, {"value": "layers", "label": "Sélection"}, {"value": "link", "label": "Lien"}, {"value": "phone", "label": "Mobile"}, {"value": "card", "label": "Paiement"}, {"value": "refresh", "label": "Mise à jour"}, {"value": "telegram", "label": "Telegram"}] },
        { "type": "text", "id": "title", "label": "Titre", "default": "Contacts spécialisés" },
        { "type": "text", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Univers Running",
      "blocks": [
        { "type": "feature", "settings": { "icon": "contact", "title": "Contacts spécialisés", "text": "Plus de 6 contacts orientés Nike Running et sportswear." } },
        { "type": "feature", "settings": { "icon": "layers", "title": "Sélections de références", "text": "Les modèles et pièces les plus recherchés." } },
        { "type": "feature", "settings": { "icon": "search", "title": "Recherche d'opportunités", "text": "Méthodes pour repérer les bonnes affaires." } },
        { "type": "feature", "settings": { "icon": "shield", "title": "Conseils d'achat", "text": "Vérifier un article et sa provenance avant d'acheter." } },
        { "type": "feature", "settings": { "icon": "handshake", "title": "Accompagnement", "text": "Des réponses à tes questions dans le groupe." } }
      ]
    }
  ]
}
{% endschema %}
