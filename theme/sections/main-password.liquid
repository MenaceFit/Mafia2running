<section class="section" style="min-height:100svh;display:grid;place-items:center">
  <div class="container container--narrow" style="display:grid;gap:22px;justify-items:center;text-align:center">
    <span class="badge"><span class="badge__dot" aria-hidden="true"></span>{{ section.settings.badge }}</span>
    <h1 class="h-display">{{ settings.brand_name | default: shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'field', style: 'grid-template-columns:1fr auto;gap:10px;width:100%;max-width:460px' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="PwEmail" class="visually-hidden">E-mail</label>
      <input id="PwEmail" type="email" name="contact[email]" placeholder="Ton e-mail" required autocomplete="email">
      <button class="btn" type="submit">Me prévenir</button>
      {%- if form.posted_successfully? -%}<p class="notice notice--success" style="grid-column:1/-1">Merci, tu seras prévenu à l'ouverture.</p>{%- endif -%}
      {%- if form.errors -%}<div class="notice notice--error" style="grid-column:1/-1">{{ form.errors | default_errors }}</div>{%- endif -%}
    {%- endform -%}
    <details style="margin-top:24px">
      <summary class="small muted" style="cursor:pointer">Accès propriétaire</summary>
      {%- form 'storefront_password', class: 'field', style: 'grid-template-columns:1fr auto;gap:10px;margin-top:12px' -%}
        <label for="Password" class="visually-hidden">Mot de passe</label>
        <input id="Password" type="password" name="password" placeholder="Mot de passe" autocomplete="current-password">
        <button class="btn btn--ghost" type="submit">Entrer</button>
        {%- if form.errors -%}<div class="notice notice--error" style="grid-column:1/-1">{{ form.errors | default_errors }}</div>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Mot de passe", "settings": [ { "type": "text", "id": "badge", "label": "Badge", "default": "Ouverture prochaine" } ] }
{% endschema %}
