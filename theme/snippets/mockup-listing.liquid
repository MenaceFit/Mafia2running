{%- comment -%} Illustrative mockup: listing quality checklist. No prices or profit figures on purpose. {%- endcomment -%}
<div class="mock-ui" role="img" aria-label="Illustration : checklist pour optimiser une annonce">
  <div class="mock-ui__panel mock-listing" aria-hidden="true">
    <div class="mock-listing__photo">{% render 'icon', name: 'camera' %}</div>
    <div class="mock-listing__body">
      <p class="mock-listing__title">Checklist annonce</p>
      <ul class="mock-listing__list">
        <li class="is-done">{% render 'icon', name: 'check' %}Photos en lumière naturelle</li>
        <li class="is-done">{% render 'icon', name: 'check' %}Titre précis : marque, modèle, taille</li>
        <li class="is-done">{% render 'icon', name: 'check' %}Étiquettes et détails photographiés</li>
        <li>{% render 'icon', name: 'check' %}Prix aligné sur le marché</li>
      </ul>
      <div class="mock-progress"><span style="width: 75%"></span></div>
    </div>
  </div>
</div>
